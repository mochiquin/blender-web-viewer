{
  "name": "blender-web-viewer",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Interactive web viewer for Blender models, built with TypeScript and Three.js",
  "scripts": {
    "predev": "node scripts/copy-draco.mjs",
    "dev": "vite",
    "prebuild": "node scripts/copy-draco.mjs",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "lil-gui": "0.20.0",
    "three": "0.180.0"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@types/node": "^22.20.5",
    "@types/three": "0.180.0",
    "typescript": "5.9.3",
    "vite": "7.3.7",
    "vitest": "3.2.7"
  }
}
